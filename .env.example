# Demo API / Next
KEEL_NETWORK=demo
KEEL_POR_SECRET=keel-demo-por-secret-v1
KEEL_POR_KEY_ID=demo

# Optional Supabase (MCP: supabase-keel) — persistence for sessions + claim audit
NEXT_PUBLIC_SUPABASE_URL=https://nllasdybyyxgvrtcsvjy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# React Bits Pro (Voxel Arc, etc.) — never commit the real key
REACTBITS_LICENSE_KEY=rbp-your-license-key

# --- Testnet live rail (never commit real secrets) ---
# After `npm run testnet:up`, sync with: bash scripts/sync-testnet-env.sh
# Issuer of TUSDC (= keel-admin). Used by POST /api/v1/chain/faucet
BIND_TUSDC_ISSUER_SECRET=
# Arbiter for claims resolve (server-side). POST /api/v1/chain/tx/resolve
BIND_ARBITER_SECRET=
# Alice / Bob keys for `npm run testnet:e2e`
BIND_ALICE_SECRET=
BIND_BOB_SECRET=
# Shared bearer for faucet + resolve (REQUIRED for /live faucet — never commit real values)
# Local tip: npm run testnet:sync-env sets a local token. Leave EMPTY on public prod unless gated.
BIND_OPS_TOKEN=
# Expose the same token to the browser ONLY on trusted local/demo deploys
NEXT_PUBLIC_BIND_OPS_TOKEN=

# Never commit real keys or PATs. Schema: supabase/migrations/001_keel_core.sql
